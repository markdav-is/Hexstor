@namespace Hexstor.Module.Bridge
@inherits ModuleBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs 
<MudDialogProvider />*@

@* Needed for snackbars 
<MudSnackbarProvider />*@

@if (!IsLoaded)
{
<p><em>Loading...</em></p>
}
else
{
    <MudCard>
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Secondary">@_shipCode</MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.body1">Bridge</MudText>
                <MudText Typo="Typo.body2">Ship Control</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.PlayArrow" Color="Color.Default" OnClick="Play" />
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardMedia Image="@_shipImage" Height="300"/>
        <MudCardContent>
            <MudText Typo="Typo.body2">Ship Style @_shipCode Level @_settingsVM.ShipLevel</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.TurnLeft" 
                Color="Color.Default" Size="Size.Large" OnClick="Left" />
            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.TurnRight" 
                Color="Color.Default" Size="Size.Large" OnClick="Right" />
            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Forward" 
                Color="Color.Success" Size="Size.Large" OnClick="Forward" />
            <MudIconButton Icon="@MudBlazor.Icons.Custom.Uncategorized.Radioactive" 
                Color="Color.Error" Size="Size.Large" OnClick="Fire" />
            <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.MilitaryTech"
                           Color="Color.Default" Size="Size.Large" OnClick="@(a=>ToggleRangeFinder(true))" />
        </MudCardActions>
    </MudCard>
}
