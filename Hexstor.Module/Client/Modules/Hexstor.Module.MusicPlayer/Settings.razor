@using System.Collections.Generic
@using System.Threading.Tasks
@inject ISettingService SettingService
@inherits ModuleBase

<div class="settings">
    <div class="form-group">
        <label>Default Audio Source:</label>
        <input type="text" @bind="_audioSourceUrl" class="form-control" />
    </div>
    <div class="form-group">
        <label>Default Volume:</label>
        <input type="range" min="0" max="100" @bind="_volume" class="form-range" />
    </div>
    <button @onclick="SaveSettings" class="btn btn-primary">Save Settings</button>
</div>

@code {
    private string _audioSourceUrl = "/music/default.mp3";
    private int _volume = 50;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);

        _audioSourceUrl = settings.TryGetValue("AudioSourceUrl", out var audioSource)
                          ? audioSource
                          : "/music/default.mp3";

        _volume = settings.TryGetValue("Volume", out var volume) && int.TryParse(volume, out var vol)
                  ? vol
                  : 50;
    }

    private async Task SaveSettings()
    {
        var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);

        settings["AudioSourceUrl"] = _audioSourceUrl;
        settings["Volume"] = _volume.ToString();

        await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);
    }
}
