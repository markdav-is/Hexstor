@namespace Hexstor.Module.MusicPlayer
@using System.Collections.Generic;
@using System.ComponentModel;
@inject SiteState SiteState
@inherits ModuleBase

<div class="music-player">
    <div class="track-info">
        <span>Now Playing: @AudioSourceUrl</span>
    </div>
    <audio id="audioElement" autoplay src="@AudioSourceUrl"></audio>
    <div class="controls">
        <button @onclick="PlayAudio">Play</button>
        <button @onclick="PauseAudio">Pause</button>
    </div>
</div>

@code {
    private ElementReference audioElement;
    private string AudioSourceUrl { get; set; } = "/music/battle.mp3";
    private int Volume { get; set; } = 50;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Resource { ResourceType = ResourceType.Stylesheet,  Url = ModulePath() + "Module.css" },
        new Resource { ResourceType = ResourceType.Script,      Url = ModulePath() + "Module.js" },
    };

    protected override Task OnInitializedAsync()
    {
        // Cast to INotifyPropertyChanged to handle PropertyChanged events
        if (SiteState.Properties is INotifyPropertyChanged propertyChangedNotifier)
        {
            propertyChangedNotifier.PropertyChanged += OnMusicPropertyChanged;
        }

        return Task.CompletedTask;
    }

    private void OnMusicPropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == "Music")
        {
            AudioSourceUrl = SiteState.Properties.Music;
            StateHasChanged();
        }
    }

    private async Task PlayAudio()
    {
        await JSRuntime.InvokeVoidAsync("playAudio", "audioElement");
    }

    private async Task PauseAudio()
    {
        await JSRuntime.InvokeVoidAsync("pauseAudio", "audioElement");
    }
}
