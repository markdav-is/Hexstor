@namespace Hexstor.Module.HexGrid
@inherits ModuleControlBase

<div @onclick="Clicked" class="hex row-@Hex.DoubCoord.Row @(Hex.Selected ? "active" : "")">
    @if (Hex.Ship != null)
    {
        <ShipCounter Heading="@Hex.Ship.Heading" />
    }
    else
    {
        <span>@Hex.DoubCoord.ToString()</span>
    }
</div>