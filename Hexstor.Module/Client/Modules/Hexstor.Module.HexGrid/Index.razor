@namespace Hexstor.Module.HexGrid
@inherits ModuleBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs 
<MudDialogProvider />*@

@* Needed for snackbars 
<MudSnackbarProvider />*@

@if (IsLoaded)
{
    <div class="hex-grid" style="--hexgrid-columns: @_settingsVM.Columns ;pointer-events: none;">
        @foreach (var hex in _gridCells.Values)
        {
            <HexTile @key='hex.DoubCoord' Hex="hex" OnClicked="HexSelected" />
        }
    </div>
}