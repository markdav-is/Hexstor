@namespace Hexstor.Module.HexGrid
@inherits ModuleBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs 
<MudDialogProvider />*@

@* Needed for snackbars 
<MudSnackbarProvider />*@

@if (IsLoaded)
{
    @* Conditionally render the spritesheet button based on the setting *@
    @if (_settingsVM.ShowSpritesheetButton)
    {
        <ActionLink Action="Spritesheet" Text="Show Spritesheet" />
    }
    <div class="hex-grid" style="--hexgrid-columns: @_settingsVM.Columns;">
        @for (int row = 0; row < _settingsVM.Rows; row++)
        {
            for (int col = 0; col < _settingsVM.Columns; col++)
            {
                var hex = _hexes.SingleOrDefault(hex => 
                                    hex.DoubCoord.Row == row 
                                    && hex.DoubCoord.Col == col);
                <HexTile Hex="@hex"/>
            }
        }
    </div>
}