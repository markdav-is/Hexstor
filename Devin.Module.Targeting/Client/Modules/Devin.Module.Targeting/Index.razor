@using Devin.Module.Targeting.Services
@using Devin.Module.Targeting.Models

@namespace Devin.Module.Targeting
@inherits ModuleBase
@inject ITargetingService TargetingService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

@if (_Targetings == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add Targeting" ResourceKey="Add" />
    <br />
    <br />
    @if (@_Targetings.Count != 0)
    {
        <Pager Items="@_Targetings">
            <Header>
                <th style="width: 1px;">&nbsp;</th>
                <th style="width: 1px;">&nbsp;</th>
                <th>@Localizer["Name"]</th>
            </Header>
            <Row>
                <td><ActionLink Action="Edit" Parameters="@($"id=" + context.TargetingId.ToString())" ResourceKey="Edit"  /></td>
                <td><ActionDialog Header="Delete Targeting" Message="Are You Sure You Wish To Delete This Targeting?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" ResourceKey="Delete"  Id="@context.TargetingId.ToString()" /></td>
                <td>@context.Name</td>
            </Row>
        </Pager>
    }
    else
    {
        <p>@Localizer["Message.DisplayNone"]</p>
    }
}

@code {
    public override string RenderMode => RenderModes.Static;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Resource { ResourceType = ResourceType.Stylesheet, Url = ModulePath() + "Module.css" },
        new Resource { ResourceType = ResourceType.Script, Url = ModulePath() + "Module.js" }
    };

    List<Targeting> _Targetings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _Targetings = await TargetingService.GetTargetingsAsync(ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Targeting {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task Delete(Targeting Targeting)
    {
        try
        {
            await TargetingService.DeleteTargetingAsync(Targeting.TargetingId, ModuleState.ModuleId);
            await logger.LogInformation("Targeting Deleted {Targeting}", Targeting);
            _Targetings = await TargetingService.GetTargetingsAsync(ModuleState.ModuleId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Targeting {Targeting} {Error}", Targeting, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }
}